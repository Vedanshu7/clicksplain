{
  "name": "docent",
  "version": "0.1.0",
  "description": "Drop-in AI widget that explains any UI element on click, like a docent for your product. Client-side only, pluggable LLM connectors.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/docent.cjs",
  "module": "./dist/docent.mjs",
  "types": "./dist/docent.d.ts",
  "unpkg": "./dist/docent.global.js",
  "jsdelivr": "./dist/docent.global.js",
  "exports": {
    ".": {
      "types": "./dist/docent.d.ts",
      "import": "./dist/docent.mjs",
      "require": "./dist/docent.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.34",
    "@ai-sdk/openai": "^4.0.34",
    "@floating-ui/dom": "^1.6.0",
    "ai": "^7.0.56",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
