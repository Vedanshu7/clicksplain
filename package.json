{
  "name": "@vedanshu7/docent",
  "version": "1.0.0",
  "description": "Drop-in AI widget that explains any UI element on click, like a docent for your product. Client-side only, pluggable LLM connectors.",
  "license": "MIT",
  "author": "Vedanshu Joshi",
  "homepage": "https://github.com/Vedanshu7/docent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vedanshu7/docent.git"
  },
  "bugs": {
    "url": "https://github.com/Vedanshu7/docent/issues"
  },
  "keywords": [
    "widget",
    "onboarding",
    "ui-explainer",
    "llm",
    "ai",
    "tooltip",
    "shadow-dom",
    "developer-tools"
  ],
  "type": "module",
  "main": "./dist/docent.cjs",
  "module": "./dist/docent.mjs",
  "types": "./dist/docent.d.ts",
  "unpkg": "./dist/docent.global.js",
  "jsdelivr": "./dist/docent.global.js",
  "exports": {
    ".": {
      "types": "./dist/docent.d.ts",
      "import": "./dist/docent.mjs",
      "require": "./dist/docent.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.34",
    "@ai-sdk/openai": "^4.0.34",
    "@floating-ui/dom": "^1.6.0",
    "ai": "^7.0.56",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
