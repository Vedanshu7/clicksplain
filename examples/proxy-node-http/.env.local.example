# Copy this file to .env.local (gitignored) and fill in your real key.
# `npm run dev` auto-loads .env.local via Node's --env-file flag.
#
# API_KEY must match whichever PROVIDER is selected below.

PROVIDER=anthropic
MODEL=claude-haiku-4-5
API_KEY=sk-ant-your-real-key-here
# Comma-separated origins allowed to call this endpoint (403 for any other).
# Stops other websites from spending your key through their visitors; it does
# not stop a script that fakes the Origin header, which is what the rate limit
# below is for. Unset allows every origin: local testing only. See README.md.
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# Requests per client IP per minute (in-memory limiter in src/server.ts).
RATE_LIMIT_PER_MINUTE=20

# Shared secret the client must send as x-widget-token. Optional locally, but
# set this (and pass the matching `token` to Clicksplain.init()) before
# deploying to production.
# WIDGET_TOKEN=some-long-random-string

PORT=8788

# To test the openai path locally instead, use:
# PROVIDER=openai
# MODEL=gpt-4o-mini
# API_KEY=sk-your-real-openai-key-here

# To route through a self-hosted Portkey AI Gateway instead (broader provider
# coverage: google, groq, mistral, bedrock, etc.), run `npx @portkey-ai/gateway`
# locally, then use:
# PROVIDER=portkey
# PORTKEY_GATEWAY_URL=http://localhost:8787/v1
# PORTKEY_PROVIDER=anthropic
# MODEL=claude-haiku-4-5
# API_KEY=sk-ant-your-real-key-here
